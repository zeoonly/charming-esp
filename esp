-- ✨ Charming Outline ESP ✨
-- Thick white outline around every player — easy to spot
-- Works in Studio AND in-game (no Drawing API needed)

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- ============ CONFIG ============
local Config = {
    Enabled = true,
    OutlineColor = Color3.fromRGB(255, 255, 255),   -- pure white (like your image)
    FillColor = Color3.fromRGB(255, 255, 255),       -- fill also white
    FillTransparency = 0.85,                         -- mostly see-through fill
    OutlineTransparency = 0,                         -- fully solid outline
    TeamCheck = true,                                -- hide teammates
    Rainbow = false,                                 -- true = rainbow outline
    Pulse = false,                                   -- true = gentle pulsing
    DepthMode = "AlwaysOnTop",                       -- AlwaysOnTop / Occluded
}

-- ============ CLEANUP OLD ============
if _G._CharmOutlineCleanup then pcall(_G._CharmOutlineCleanup) end

local Highlights = {}
local Connections = {}

-- ============ HELPERS ============
local function isSameTeam(player)
    if not Config.TeamCheck then return false end
    if not player.Team or not LocalPlayer.Team then return false end
    return player.Team == LocalPlayer.Team
end

local function removeHighlight(player)
    if Highlights[player] then
        pcall(function() Highlights[player]:Destroy() end)
        Highlights[player] = nil
    end
end

local function attachHighlight(player)
    if player == LocalPlayer then return end

    removeHighlight(player)

    local char = player.Character
    if not char then return end

    local hl = Instance.new("Highlight")
    hl.Name = "CharmingOutline"
    hl.FillColor = Config.FillColor
    hl.FillTransparency = Config.FillTransparency
    hl.OutlineColor = Config.OutlineColor
    hl.OutlineTransparency = Config.OutlineTransparency

    if Config.DepthMode == "Occluded" then
        hl.DepthMode = Enum.HighlightDepthMode.Occluded
    else
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    end

    hl.Adornee = char
    hl.Parent = char

    Highlights[player] = hl

    -- Re-apply on respawn
    table.insert(Connections, player.CharacterAdded:Connect(function()
        task.wait(0.3)
        attachHighlight(player)
    end))
end

-- ============ MAIN UPDATE LOOP ============
local t = 0
local runConn
runConn = RunService.RenderStepped:Connect(function(dt)
    if not Config.Enabled then
        for _, hl in pairs(Highlights) do
            if hl then hl.Enabled = false end
        end
        return
    end
    t += dt

    for player, hl in pairs(Highlights) do
        if not hl or not hl.Parent then continue end

        if isSameTeam(player) then
            hl.Enabled = false
            continue
        end

        hl.Enabled = true

        if Config.Rainbow then
            local c = Color3.fromHSV((t * 0.15 + player.UserId % 100 / 100) % 1, 0.6, 1)
            hl.OutlineColor = c
            hl.FillColor = c
        else
            hl.OutlineColor = Config.OutlineColor
            hl.FillColor = Config.FillColor
        end

        if Config.Pulse then
            hl.OutlineTransparency = math.sin(t * 3) * 0.2
        else
            hl.OutlineTransparency = Config.OutlineTransparency
        end
    end
end)

-- ============ PLAYER MANAGEMENT ============
for _, p in ipairs(Players:GetPlayers()) do
    if p.Character then
        attachHighlight(p)
    else
        p.CharacterAdded:Connect(function()
            task.wait(0.3)
            attachHighlight(p)
        end)
    end
end

table.insert(Connections, Players.PlayerAdded:Connect(function(p)
    p.CharacterAdded:Connect(function()
        task.wait(0.3)
        attachHighlight(p)
    end)
    if p.Character then attachHighlight(p) end
end))

table.insert(Connections, Players.PlayerRemoving:Connect(removeHighlight))

-- ============ KILL ============
_G._CharmOutlineCleanup = function()
    if runConn then pcall(function() runConn:Disconnect() end) end
    for _, c in ipairs(Connections) do
        pcall(function() c:Disconnect() end)
    end
    Connections = {}
    for p, _ in pairs(Highlights) do removeHighlight(p) end
    print("✨ Charming Outline ESP unloaded")
end

print("✨ Charming Outline ESP loaded — everyone is outlined now!")
print("   To unload: run _G._CharmOutlineCleanup()")
