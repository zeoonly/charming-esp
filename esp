-- ============ ESP LOGIC ============
local function isSameTeam(player, useTeamCheck)
    if not useTeamCheck then return false end
    if not player.Team or not LocalPlayer.Team then return false end
    return player.Team == LocalPlayer.Team
end

local function removeESP(player)
    if ESP[player] then
        pcall(function() if ESP[player].Highlight then ESP[player].Highlight:Destroy() end end)
        pcall(function() if ESP[player].SelectionBox then ESP[player].SelectionBox:Destroy() end end)
        ESP[player] = nil
    end
end

local function attachESP(player)
    if player == LocalPlayer then return end
    removeESP(player)

    local char = player.Character
    if not char then return end

    local hl = Instance.new("Highlight")
    hl.Name = "CharmingHL"
    hl.FillColor = Config.OutlineColor
    hl.FillTransparency = Config.FillTransparency
    hl.OutlineColor = Config.OutlineColor
    hl.OutlineTransparency = 0
    hl.DepthMode = Config.ThroughWalls and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded
    hl.Adornee = char
    hl.Parent = char

    local box = Instance.new("SelectionBox")
    box.Name = "CharmingSB"
    box.Color3 = Config.OutlineColor
    box.LineThickness = Config.BoxThickness
    box.SurfaceColor3 = Config.OutlineColor
    box.SurfaceTransparency = 1
    box.Adornee = char
    box.Parent = char

    ESP[player] = { Highlight = hl, SelectionBox = box }

    track(player.CharacterAdded:Connect(function()
        task.wait(0.3)
        attachESP(player)
    end))
end

-- ============ AIMBOT LOGIC ============
local function isVisible(targetPart)
    if not Config.AimbotVisibleCheck then return true end
    local origin = Camera.CFrame.Position
    local dir = (targetPart.Position - origin)
    local ray = Ray.new(origin, dir)
    local hit = workspace:FindPartOnRayWithIgnoreList(ray, {LocalPlayer.Character, Camera})
    if hit and hit:IsDescendantOf(targetPart.Parent) then
        return true
    end
    return false
end

local function getClosestToCursor(fovRadius, partName, useTeamCheck, maxDist)
    local mouse = UserInputService:GetMouseLocation()
    local closest, closestDist = nil, fovRadius

    for _, player in pairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if isSameTeam(player, useTeamCheck) then continue end

        local char = player.Character
        if not char then continue end
        local part = char:FindFirstChild(partName) or char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
        if not part then continue end
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then continue end

        local dist = (Camera.CFrame.Position - part.Position).Magnitude
        if dist > maxDist then continue end

        local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
        if not onScreen then continue end

        local dx = screenPos.X - mouse.X
        local dy = screenPos.Y - mouse.Y
        local screenDist = math.sqrt(dx * dx + dy * dy)

        if screenDist < closestDist then
            closestDist = screenDist
            closest = { player = player, part = part }
        end
    end
    return closest
end

local function applyAimbot(dt)
    if not Config.AimbotEnabled or not AimbotHeld then return end

    local target = getClosestToCursor(
        Config.AimbotFOV,
        Config.AimbotTargetPart,
        Config.AimbotTeamCheck,
        Config.AimbotMaxDistance
    )

    AimbotTarget = target
    if not target then return end

    if Config.AimbotVisibleCheck and not isVisible(target.part) then return end

    local targetPos = target.part.Position
    local currentCF = Camera.CFrame
    local desiredCF = CFrame.new(currentCF.Position, targetPos)

    -- Smoothing: lerp between current and desired
    -- Lower smoothing value = faster snap
    local smoothFactor = 1 - Config.AimbotSmoothing
    smoothFactor = math.clamp(smoothFactor * dt * 60, 0, 1)

    Camera.CFrame = currentCF:Lerp(desiredCF, smoothFactor)
end

-- ============ TRIGGERBOT LOGIC ============
local function isCrosshairOnTarget(fovTolerance, partName, useTeamCheck, maxDist)
    local mouse = UserInputService:GetMouseLocation()
    local best = false

    for _, player in pairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if isSameTeam(player, useTeamCheck) then continue end

        local char = player.Character
        if not char then continue end
        local part = char:FindFirstChild(partName) or char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
        if not part then continue end
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then continue end

        local dist = (Camera.CFrame.Position - part.Position).Magnitude
        if dist > maxDist then continue end

        local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
        if not onScreen then continue end

        local dx = screenPos.X - mouse.X
        local dy = screenPos.Y - mouse.Y
        local screenDist = math.sqrt(dx * dx + dy * dy)

        if screenDist <= fovTolerance then
            if Config.TriggerbotVisibleCheck then
                if isVisible(part) then return true end
            else
                return true
            end
        end
    end
    return false
end

local function applyTriggerbot(dt)
    TriggerActive = false
    if not Config.TriggerbotEnabled then return end

    TriggerCooldown = math.max(0, TriggerCooldown - dt)
    if TriggerCooldown > 0 then return end

    local onTarget = isCrosshairOnTarget(
        Config.TriggerbotFOV,
        "Head",
        Config.TriggerbotTeamCheck,
        Config.TriggerbotMaxDistance
    )

    if onTarget then
        TriggerActive = true
        pcall(function()
            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
        end)
        task.wait(Config.TriggerbotDelay)
        pcall(function()
            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
        end)
        TriggerCooldown = Config.TriggerbotDelay + 0.05
    end
end

-- ============ MAIN LOOP ============
local t = 0
local runConn
runConn = RunService.RenderStepped:Connect(function(dt)
    if Killed then return end
    t += dt

    -- ===== ESP UPDATE =====
    for player, data in pairs(ESP) do
        local hl = data.Highlight
        local box = data.SelectionBox
        if not hl or not hl.Parent then continue end

        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local humanoid = char and char:FindFirstChildOfClass("Humanoid")

        if not Config.ESPEnabled
            or not char or not hrp or not humanoid
            or humanoid.Health <= 0
            or isSameTeam(player, Config.TeamCheck)
        then
            hl.Enabled = false
            if box then box.Visible = false end
            continue
        end

        local dist = (Camera.CFrame.Position - hrp.Position).Magnitude
        if dist > Config.MaxDistance then
            hl.Enabled = false
            if box then box.Visible = false end
            continue
        end

        hl.Enabled = true
        hl.DepthMode = Config.ThroughWalls and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded

        local c
        if Config.Rainbow then
            c = Color3.fromHSV((t * 0.15 + player.UserId % 100 / 100) % 1, 0.6, 1)
        elseif player.Team then
            c = player.TeamColor.Color
        else
            c = Config.OutlineColor
        end

        hl.OutlineColor = c
        hl.FillColor = c
        hl.OutlineTransparency = 0
        hl.FillTransparency = Config.ShowFill and Config.FillTransparency or 1

        if box then
            box.Visible = Config.ThickOutline
            box.Color3 = c
            box.LineThickness = Config.BoxThickness
            box.SurfaceTransparency = 1
        end
    end

    -- ===== AIMBOT =====
    pcall(applyAimbot, dt)

    -- ===== TRIGGERBOT =====
    pcall(applyTriggerbot, dt)

    -- ===== FOV CIRCLES =====
    if hasDrawing then
        local viewport = Camera.ViewportSize
        local center = Vector2.new(viewport.X / 2, viewport.Y / 2)

        if FOVCircle then
            FOVCircle.Position = center
            FOVCircle.Radius = Config.AimbotFOV
            FOVCircle.Visible = Config.AimbotEnabled and Config.AimbotDrawFOV
            FOVCircle.Color = AimbotTarget and Palette.Success or Config.FOVColor
        end
        if TriggerFOVCircle then
            TriggerFOVCircle.Position = center
            TriggerFOVCircle.Radius = Config.TriggerbotFOV
            TriggerFOVCircle.Visible = Config.TriggerbotEnabled
            TriggerFOVCircle.Color = TriggerActive and Palette.Success or Palette.Danger
        end
    end
end)

