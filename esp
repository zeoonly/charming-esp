-- ============ HELPERS ============
local function isSameTeam(player)
    if not Config.TeamCheck then return false end
    if not player.Team or not LocalPlayer.Team then return false end
    return player.Team == LocalPlayer.Team
end

local function getCharacter(player)
    local char = player.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not humanoid then return nil end
    return char, hrp, humanoid
end

local function hueToColor(h, s, v)
    return Color3.fromHSV(h % 1, s or 0.55, v or 1)
end

-- ============ MAIN LOOP ============
local t = 0
local frame = 0
local function updateESP(dt)
    if Killed then return end
    t += dt
    frame += 1

    local glyph = CharmPresets[Config.CharmStyle] or "♥"
    local drawnCount = 0

    for _, player in pairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end

        local char, hrp, humanoid = getCharacter(player)

        if not Config.Enabled or not char or not hrp or humanoid.Health <= 0 or isSameTeam(player) then
            hideAllDrawings(player)
            continue
        end

        if not Drawings[player] then
            createPlayerDrawings(player)
        end

        local d = Drawings[player]
        local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
        local distance = (Camera.CFrame.Position - hrp.Position).Magnitude

        if not onScreen or distance > Config.MaxDistance then
            hideAllDrawings(player)
            continue
        end

        drawnCount += 1

        local size = char:GetExtentsSize()
        local topPos = Camera:WorldToViewportPoint(hrp.Position + Vector3.new(0, size.Y/2, 0))
        local bottomPos = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, size.Y/2, 0))
        local onScreenHeight = math.abs(topPos.Y - bottomPos.Y)

        local pulse = 1 + math.sin(t * 2.2 + player.UserId) * 0.05
        local baseRadius = (onScreenHeight * 0.62) * pulse

        local baseColor
        if Config.RainbowCharm then
            baseColor = hueToColor((t * 0.15) + (player.UserId % 100) / 100)
        elseif player.Team then
            baseColor = player.TeamColor.Color:Lerp(Color3.new(1,1,1), 0.25)
        else
            baseColor = Palette.Accent
        end
        local haloColor = baseColor:Lerp(Color3.new(1,1,1), 0.35)

        -- ===== FLOATING CHARM =====
        local charmVisible = Config.ShowCharm
        d.Charm.Visible = charmVisible
        d.CharmGlow.Visible = charmVisible and Config.ShowCharmGlow
        d.CharmHalo.Visible = charmVisible

        if charmVisible then
            local bob = Config.CharmBounce and math.sin(t * 3 + player.UserId) * 8 or 0
            local charmY = topPos.Y - 28 + bob
            local charmX = pos.X

            local charmScale = math.clamp(onScreenHeight / 120, 0.7, 1.8)
            local charmSize = math.floor(28 * charmScale)
            local glowR = (charmSize * 0.9) * (1 + math.sin(t * 4 + player.UserId) * 0.1)

            d.Charm.Text = glyph
            d.Charm.Size = charmSize
            d.Charm.Position = Vector2.new(charmX, charmY)
            d.Charm.Color = baseColor:Lerp(Color3.new(1,1,1), 0.4)
            d.Charm.Transparency = 0.05

            if Config.ShowCharmGlow then
                d.CharmGlow.Radius = glowR
                d.CharmGlow.Position = Vector2.new(charmX, charmY)
                d.CharmGlow.Color = haloColor
                d.CharmGlow.Transparency = 0.55
            end

            d.CharmHalo.Radius = charmSize * 0.95
            d.CharmHalo.Position = Vector2.new(charmX, charmY)
            d.CharmHalo.Color = baseColor
            d.CharmHalo.Transparency = 0.35
            d.CharmHalo.Thickness = 1 + math.sin(t * 5 + player.UserId) * 0.5
        end

        -- ===== AURA =====
        d.Halo1.Visible = Config.ShowAura
        d.Ring.Visible = Config.ShowAura
        d.Ring2.Visible = Config.ShowAura

        if Config.ShowAura then
            d.Halo1.Radius = baseRadius * 0.95
            d.Halo1.Position = Vector2.new(pos.X, pos.Y)
            d.Halo1.Color = haloColor
            d.Halo1.Transparency = 0.92

            d.Ring.Radius = baseRadius
            d.Ring.Position = Vector2.new(pos.X, pos.Y)
            d.Ring.Color = baseColor
            d.Ring.Transparency = 0.15
            d.Ring.Thickness = 2

            local outerPulse = 1 + math.sin(t * 3 + player.UserId * 0.5) * 0.08
            d.Ring2.Radius = baseRadius * 1.14 * outerPulse
            d.Ring2.Position = Vector2.new(pos.X, pos.Y)
            d.Ring2.Color = baseColor:Lerp(Palette.Accent2, 0.5)
            d.Ring2.Transparency = 0.5
            d.Ring2.Thickness = 1
        end

        -- ===== SPARKLES =====
        local sparklesVisible = Config.ShowSparkles and Config.ShowAura
        for i, sp in ipairs(d.Sparkles) do
            sp.Visible = sparklesVisible
            if sparklesVisible then
                local angle = (t * 1.5) + (i - 1) * (math.pi * 2 / SPARKLE_COUNT) + (player.UserId % 100) * 0.01
                local r = baseRadius * (1 + math.sin(t * 4 + i) * 0.04)
                local sx = pos.X + math.cos(angle) * r
                local sy = pos.Y + math.sin(angle) * r
                sp.Position = Vector2.new(sx, sy)
                local twinkle = 0.4 + 0.6 * (0.5 + 0.5 * math.sin(t * 3 + i * 1.7))
                sp.Transparency = 1 - twinkle
                sp.Color = baseColor:Lerp(Color3.new(1,1,1), 0.5)
                sp.Size = 12 + (i % 3) * 2
            end
        end

        -- ===== NAME =====
        d.Name.Visible = Config.ShowNames
        if Config.ShowNames then
            local nameY = charmVisible and (topPos.Y - 28 - 22) or (pos.Y - baseRadius - 20)
            d.Name.Text = player.Name
            d.Name.Position = Vector2.new(pos.X, nameY)
            d.Name.Color = baseColor:Lerp(Color3.new(1,1,1), 0.35)
        end

        -- ===== HEALTH =====
        d.HealthBarBG.Visible = Config.ShowHealth
        d.HealthBar.Visible = Config.ShowHealth
        if Config.ShowHealth then
            local hp = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
            local barH = baseRadius * 1.4
            local barX = pos.X - baseRadius - 10
            local barY = pos.Y - barH / 2
            local filledH = barH * hp

            d.HealthBarBG.Size = Vector2.new(3, barH)
            d.HealthBarBG.Position = Vector2.new(barX, barY)
            d.HealthBar.Size = Vector2.new(3, filledH)
            d.HealthBar.Position = Vector2.new(barX, barY + (barH - filledH))
            d.HealthBar.Color = Color3.fromRGB(
                255 * (1 - hp) + 60,
                255 * hp + 40,
                90 + 40 * hp
            )
        end

        -- ===== DISTANCE =====
        d.Distance.Visible = Config.ShowDistance
        if Config.ShowDistance then
            d.Distance.Text = string.format("· %d studs ·", math.floor(distance))
            d.Distance.Position = Vector2.new(pos.X, pos.Y + baseRadius + 10)
            d.Distance.Color = Palette.TextDim
        end

        -- ===== TRACER =====
        d.Tracer.Visible = Config.ShowTracers
        if Config.ShowTracers then
            d.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
            d.Tracer.To = Vector2.new(pos.X, pos.Y + baseRadius)
            d.Tracer.Color = baseColor
        end
    end

    if frame % 300 == 0 then
        print(string.format("[Charming] running — visible: %d", drawnCount))
    end
end

