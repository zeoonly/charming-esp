-- ============ HIGHLIGHT + SELECTIONBOX ============
local function isSameTeam(player)
    if not Config.TeamCheck then return false end
    if not player.Team or not LocalPlayer.Team then return false end
    return player.Team == LocalPlayer.Team
end

local function removeESP(player)
    if ESP[player] then
        pcall(function() if ESP[player].Highlight then ESP[player].Highlight:Destroy() end end)
        pcall(function() if ESP[player].SelectionBox then ESP[player].SelectionBox:Destroy() end end)
        ESP[player] = nil
    end
end

local function attachESP(player)
    if player == LocalPlayer then return end

    removeESP(player)

    local char = player.Character
    if not char then return end

    -- Highlight (fill silhouette)
    local hl = Instance.new("Highlight")
    hl.Name = "CharmingHL"
    hl.FillColor = Config.OutlineColor
    hl.FillTransparency = Config.FillTransparency
    hl.OutlineColor = Config.OutlineColor
    hl.OutlineTransparency = 0
    hl.DepthMode = Config.ThroughWalls and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded
    hl.Adornee = char
    hl.Parent = char

    -- SelectionBox (thicker line)
    local box = Instance.new("SelectionBox")
    box.Name = "CharmingSB"
    box.Color3 = Config.OutlineColor
    box.LineThickness = Config.BoxThickness
    box.SurfaceColor3 = Config.OutlineColor
    box.SurfaceTransparency = 1
    box.Adornee = char
    box.Parent = char

    ESP[player] = { Highlight = hl, SelectionBox = box }

    track(player.CharacterAdded:Connect(function()
        task.wait(0.3)
        attachESP(player)
    end))
end

-- ============ MAIN LOOP ============
local t = 0
local runConn
runConn = RunService.RenderStepped:Connect(function(dt)
    if Killed then return end
    t += dt

    for player, data in pairs(ESP) do
        local hl = data.Highlight
        local box = data.SelectionBox
        if not hl or not hl.Parent then continue end

        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local humanoid = char and char:FindFirstChildOfClass("Humanoid")

        -- Dead / invalid / teammate / disabled -> hide
        if not Config.Enabled
            or not char or not hrp or not humanoid
            or humanoid.Health <= 0
            or isSameTeam(player)
        then
            hl.Enabled = false
            if box then box.Visible = false end
            continue
        end

        -- Distance check
        local dist = (workspace.CurrentCamera.CFrame.Position - hrp.Position).Magnitude
        if dist > Config.MaxDistance then
            hl.Enabled = false
            if box then box.Visible = false end
            continue
        end

        hl.Enabled = true
        hl.DepthMode = Config.ThroughWalls and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded

        -- Color
        local c
        if Config.Rainbow then
            c = Color3.fromHSV((t * 0.15 + player.UserId % 100 / 100) % 1, 0.6, 1)
        elseif player.Team then
            c = player.TeamColor.Color
        else
            c = Config.OutlineColor
        end

        hl.OutlineColor = c
        hl.FillColor = c

        if Config.Pulse then
            hl.OutlineTransparency = math.sin(t * 3) * 0.2
            hl.FillTransparency = Config.FillTransparency + math.sin(t * 3) * 0.05
        else
            hl.OutlineTransparency = 0
            hl.FillTransparency = Config.FillTransparency
        end

        -- Fill toggle
        if not Config.ShowFill then
            hl.FillTransparency = 1
        end

        -- Thick outline (SelectionBox)
        if box then
            box.Visible = Config.ThickOutline
            box.Color3 = c
            box.LineThickness = Config.BoxThickness
            box.SurfaceTransparency = 1
        end
    end
end)

