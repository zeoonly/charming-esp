-- ============ KILL ============
local function Kill()
    if Killed then return end
    Killed = true

    for p, _ in pairs(Drawings) do clearDrawings(p) end
    Drawings = {}

    for _, c in ipairs(Connections) do pcall(function() c:Disconnect() end) end
    Connections = {}

    for _, th in ipairs(Threads) do pcall(function() task.cancel(th) end) end
    Threads = {}

    if ScreenGui and ScreenGui.Parent then
        local fade = TweenService:Create(Main, TweenInfo.new(0.25), {
            Size = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 1
        })
        fade:Play()
        fade.Completed:Connect(function()
            if ScreenGui then ScreenGui:Destroy() end
        end)
        task.delay(0.4, function()
            if ScreenGui then pcall(function() ScreenGui:Destroy() end) end
        end)
    end

    if getgenv then getgenv().CharmingESP = nil end
    print("✨ Charming ESP unloaded")
end

