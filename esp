-- ============ KILL ============
local function Kill()
    if Killed then return end
    Killed = true

    if runConn then pcall(function() runConn:Disconnect() end) end
    for _, c in ipairs(Connections) do pcall(function() c:Disconnect() end) end
    Connections = {}

    for p, _ in pairs(ESP) do removeESP(p) end
    ESP = {}

    if ScreenGui and ScreenGui.Parent then
        ScreenGui:Destroy()
    end

    _G._CharmOutlineCleanup = nil
    print("✨ Outline ESP unloaded")
end

track(KillBtn.MouseButton1Click:Connect(Kill))
track(UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.Delete or input.KeyCode == Enum.KeyCode.End then
        Kill()
    end
end))

_G._CharmOutlineCleanup = Kill

