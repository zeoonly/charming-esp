-- ============ KILL ============
_G._NPCHunterCleanup = function()
    if Killed then return end
    Killed = true

    if runConn then pcall(function() runConn:Disconnect() end) end
    for _, c in ipairs(Connections) do
        pcall(function() c:Disconnect() end)
    end
    Connections = {}

    for p, _ in pairs(PlayerESP) do removePlayerESP(p) end
    PlayerESP = {}
    for m, _ in pairs(NPCESP) do removeNPCESP(m) end
    NPCESP = {}

    if FOVCircle then pcall(function() FOVCircle:Remove() end) end
    if TriggerFOVCircle then pcall(function() TriggerFOVCircle:Remove() end) end
    FOVCircle = nil
    TriggerFOVCircle = nil

    if ScreenGui and ScreenGui.Parent then ScreenGui:Destroy() end

    _G._NPCHunterCleanup = nil
    print("✨ NPC Hunter unloaded")
end

track(KillBtn.MouseButton1Click:Connect(_G._NPCHunterCleanup))

