-- ============ TARGET HELPERS ============
local function isSameTeam(player, useTeamCheck)
    if not useTeamCheck then return false end
    if not player.Team or not LocalPlayer.Team then return false end
    return player.Team == LocalPlayer.Team
end

-- Returns array of {part=, model=, isNPC=, player=}
local function getTargets(partName, useTeamCheck, maxDist, includeNPCs)
    local myPos = Camera.CFrame.Position
    local list = {}

    -- Players
    if Config.TargetPlayers then
        for _, player in ipairs(Players:GetPlayers()) do
            if player == LocalPlayer then continue end
            if isSameTeam(player, useTeamCheck) then continue end
            local char = player.Character
            if not char then continue end
            local part = char:FindFirstChild(partName) or char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
            if not part then continue end
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not hum or hum.Health <= 0 then continue end
            local dist = (myPos - part.Position).Magnitude
            if dist > maxDist then continue end
            list[#list+1] = { part = part, model = char, isNPC = false, player = player }
        end
    end

    -- NPCs
    if includeNPCs and Config.TargetNPCs then
        for _, obj in ipairs(workspace:GetChildren()) do
            if not obj:IsA("Model") then continue end
            if obj == LocalPlayer.Character then continue end
            local hum = obj:FindFirstChildOfClass("Humanoid")
            if not hum or hum.Health <= 0 then continue end
            local part = obj:FindFirstChild(partName) or obj:FindFirstChild("Head") or obj:FindFirstChild("HumanoidRootPart")
            if not part then continue end
            local dist = (myPos - part.Position).Magnitude
            if dist > maxDist then continue end
            list[#list+1] = { part = part, model = obj, isNPC = true, player = nil }
        end
    end

    return list
end

local function isVisible(part, useCheck)
    if not useCheck then return true end
    local origin = Camera.CFrame.Position
    local ray = Ray.new(origin, part.Position - origin)
    local hit = workspace:FindPartOnRayWithIgnoreList(ray, {LocalPlayer.Character, Camera})
    if hit and (hit == part or hit:IsDescendantOf(part.Parent)) then
        return true
    end
    return false
end

local function getClosestToCursor(fovRadius, partName, useTeamCheck, maxDist, includeNPCs)
    local mouse = UserInputService:GetMouseLocation()
    local closest, closestDist = nil, fovRadius
    for _, tgt in ipairs(getTargets(partName, useTeamCheck, maxDist, includeNPCs)) do
        local screenPos, onScreen = Camera:WorldToViewportPoint(tgt.part.Position)
        if not onScreen then continue end
        local dx = screenPos.X - mouse.X
        local dy = screenPos.Y - mouse.Y
        local d = math.sqrt(dx*dx + dy*dy)
        if d < closestDist then
            closestDist = d
            closest = tgt
        end
    end
    return closest
end

local function isCrosshairOnTarget(fovTol, partName, useTeamCheck, maxDist, includeNPCs)
    local mouse = UserInputService:GetMouseLocation()
    for _, tgt in ipairs(getTargets(partName, useTeamCheck, maxDist, includeNPCs)) do
        local screenPos, onScreen = Camera:WorldToViewportPoint(tgt.part.Position)
        if not onScreen then continue end
        local dx = screenPos.X - mouse.X
        local dy = screenPos.Y - mouse.Y
        local d = math.sqrt(dx*dx + dy*dy)
        if d <= fovTol then
            if isVisible(tgt.part, Config.TriggerbotVisibleCheck) then
                return true
            end
        end
    end
    return false
end

-- ============ PLAYER ESP ============
local function removePlayerESP(player)
    if PlayerESP[player] then
        pcall(function() if PlayerESP[player].HL then PlayerESP[player].HL:Destroy() end end)
        pcall(function() if PlayerESP[player].Box then PlayerESP[player].Box:Destroy() end end)
        if PlayerESP[player].Conn then PlayerESP[player].Conn:Disconnect() end
        PlayerESP[player] = nil
    end
end

local function attachPlayerESP(player)
    if player == LocalPlayer then return end
    removePlayerESP(player)
    local char = player.Character
    if not char then return end

    local hl = Instance.new("Highlight")
    hl.FillColor = Config.PlayerColor
    hl.FillTransparency = Config.FillTransparency
    hl.OutlineColor = Config.PlayerColor
    hl.OutlineTransparency = 0
    hl.DepthMode = Config.ThroughWalls and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded
    hl.Adornee = char
    hl.Parent = char

    local box = Instance.new("SelectionBox")
    box.Color3 = Config.PlayerColor
    box.LineThickness = Config.BoxThickness
    box.SurfaceTransparency = 1
    box.Adornee = char
    box.Parent = char

    local conn = player.CharacterAdded:Connect(function()
        if Killed then return end
        task.wait(0.3)
        attachPlayerESP(player)
    end)

    PlayerESP[player] = { HL = hl, Box = box, Conn = conn }
end

-- ============ NPC ESP ============
local function removeNPCESP(model)
    if NPCESP[model] then
        pcall(function() if NPCESP[model].HL then NPCESP[model].HL:Destroy() end end)
        pcall(function() if NPCESP[model].Box then NPCESP[model].Box:Destroy() end end)
        NPCESP[model] = nil
    end
end

local function attachNPCESP(model)
    if NPCESP[model] then return end
    local hl = Instance.new("Highlight")
    hl.FillColor = Config.NPCColor
    hl.FillTransparency = Config.FillTransparency
    hl.OutlineColor = Config.NPCColor
    hl.OutlineTransparency = 0
    hl.DepthMode = Config.ThroughWalls and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded
    hl.Adornee = model
    hl.Parent = model

    local box = Instance.new("SelectionBox")
    box.Color3 = Config.NPCColor
    box.LineThickness = Config.BoxThickness
    box.SurfaceTransparency = 1
    box.Adornee = model
    box.Parent = model

    NPCESP[model] = { HL = hl, Box = box }
end

local function scanNPCs()
    for _, obj in ipairs(workspace:GetChildren()) do
        if not obj:IsA("Model") then continue end
        if obj == LocalPlayer.Character then continue end
        if obj:FindFirstChildOfClass("Humanoid") then
            if not NPCESP[obj] then
                attachNPCESP(obj)
            end
        end
    end
    -- Clean up dead/destroyed NPCs
    for model, _ in pairs(NPCESP) do
        if not model.Parent then
            removeNPCESP(model)
        end
    end
end

-- ============ AIMBOT ============
local aimAccum = 0
local function applyAimbot(dt)
    if not Config.AimbotEnabled or not AimbotHeld then
        AimbotTarget = nil
        return
    end
    aimAccum += dt
    if aimAccum < 0.05 and AimbotTarget and AimbotTarget.part.Parent then
        -- reuse
    else
        aimAccum = 0
        AimbotTarget = getClosestToCursor(Config.AimbotFOV, "Head", Config.AimbotTeamCheck, Config.AimbotMaxDistance, Config.AimbotTargetNPCs)
    end
    if not AimbotTarget then return end
    if not isVisible(AimbotTarget.part, Config.AimbotVisibleCheck) then return end

    local currentCF = Camera.CFrame
    local desiredCF = CFrame.new(currentCF.Position, AimbotTarget.part.Position)
    local smoothFactor = math.clamp((1 - Config.AimbotSmoothing) * dt * 60, 0, 1)
    Camera.CFrame = currentCF:Lerp(desiredCF, smoothFactor)
end

-- ============ TRIGGERBOT ============
local trigAccum = 0
local function applyTriggerbot(dt)
    TriggerActive = false
    if not Config.TriggerbotEnabled then return end
    TriggerCooldown = math.max(0, TriggerCooldown - dt)
    if TriggerCooldown > 0 then return end
    trigAccum += dt
    if trigAccum < 0.03 then return end
    trigAccum = 0

    if isCrosshairOnTarget(Config.TriggerbotFOV, "Head", Config.TriggerbotTeamCheck, Config.TriggerbotMaxDistance, Config.TriggerbotTargetNPCs) then
        TriggerActive = true
        pcall(function()
            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
        end)
        task.delay(Config.TriggerbotDelay, function()
            pcall(function()
                VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
            end)
        end)
        TriggerCooldown = Config.TriggerbotDelay + 0.08
    end
end

-- ============ MAIN LOOP ============
local t = 0
local espTick = 0
local npcTick = 0
local runConn
runConn = RunService.RenderStepped:Connect(function(dt)
    if Killed then return end
    t += dt
    espTick += dt
    npcTick += dt

    -- NPC scan every 1s (throttled for performance)
    if npcTick >= 1.0 then
        npcTick = 0
        if Config.TargetNPCs then scanNPCs() end
    end

    -- ESP update every 0.1s
    if espTick >= 0.1 then
        espTick = 0

        -- Players
        for player, data in pairs(PlayerESP) do
            local hl, box = data.HL, data.Box
            if not hl or not hl.Parent then continue end
            local char = player.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")

            if not Config.ESPEnabled or not Config.TargetPlayers
                or not char or not hrp or not hum or hum.Health <= 0
                or isSameTeam(player, Config.TeamCheck)
            then
                hl.Enabled = false
                if box then box.Visible = false end
                continue
            end

            local dist = (Camera.CFrame.Position - hrp.Position).Magnitude
            if dist > Config.MaxDistance then
                hl.Enabled = false
                if box then box.Visible = false end
                continue
            end

            hl.Enabled = true
            hl.DepthMode = Config.ThroughWalls and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded

            local c
            if Config.Rainbow then
                c = Color3.fromHSV((t * 0.15 + player.UserId % 100 / 100) % 1, 0.6, 1)
            elseif player.Team then
                c = player.TeamColor.Color
            else
                c = Config.PlayerColor
            end

            hl.OutlineColor = c
            hl.FillColor = c
            hl.OutlineTransparency = 0
            hl.FillTransparency = Config.ShowFill and Config.FillTransparency or 1
            if box then
                box.Visible = Config.ThickOutline
                box.Color3 = c
            end
        end

        -- NPCs
        for model, data in pairs(NPCESP) do
            local hl, box = data.HL, data.Box
            if not hl or not hl.Parent or not model.Parent then continue end
            local hum = model:FindFirstChildOfClass("Humanoid")
            local root = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Head")

            if not Config.ESPEnabled or not Config.TargetNPCs or not hum or hum.Health <= 0 then
                hl.Enabled = false
                if box then box.Visible = false end
                continue
            end

            local dist = root and (Camera.CFrame.Position - root.Position).Magnitude or 0
            if dist > Config.MaxDistance then
                hl.Enabled = false
                if box then box.Visible = false end
                continue
            end

            hl.Enabled = true
            hl.DepthMode = Config.ThroughWalls and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded

            local c = Config.NPCColor
            if Config.Rainbow then
                c = Color3.fromHSV((t * 0.15 + model:GetDebugId() % 100 / 100) % 1, 0.6, 1)
            end

            hl.OutlineColor = c
            hl.FillColor = c
            hl.OutlineTransparency = 0
            hl.FillTransparency = Config.ShowFill and Config.FillTransparency or 1
            if box then
                box.Visible = Config.ThickOutline
                box.Color3 = c
            end
        end
    end

    pcall(applyAimbot, dt)
    pcall(applyTriggerbot, dt)

    if hasDrawing then
        local vp = Camera.ViewportSize
        local center = Vector2.new(vp.X / 2, vp.Y / 2)
        if FOVCircle then
            FOVCircle.Visible = Config.AimbotEnabled and Config.AimbotDrawFOV
            if FOVCircle.Visible then
                FOVCircle.Position = center
                FOVCircle.Radius = Config.AimbotFOV
                FOVCircle.Color = AimbotTarget and P.Success or Config.FOVColor
            end
        end
        if TriggerFOVCircle then
            TriggerFOVCircle.Visible = Config.TriggerbotEnabled
            if TriggerFOVCircle.Visible then
                TriggerFOVCircle.Position = center
                TriggerFOVCircle.Radius = Config.TriggerbotFOV
                TriggerFOVCircle.Color = TriggerActive and P.Success or P.Danger
            end
        end
    end
end)

