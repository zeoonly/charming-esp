    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = Card

    local VLabel = Instance.new("TextLabel")
    VLabel.Size = UDim2.new(0, 60, 0, 20)
    VLabel.Position = UDim2.new(1, -70, 0, 4)
    VLabel.BackgroundTransparency = 1
    VLabel.Text = tostring(Config[key])
    VLabel.TextColor3 = P.Accent
    VLabel.TextSize = 13
    VLabel.Font = Enum.Font.GothamBold
    VLabel.TextXAlignment = Enum.TextXAlignment.Right
    VLabel.Parent = Card

    local BG = Instance.new("Frame")
    BG.Size = UDim2.new(1, -28, 0, 6)
    BG.Position = UDim2.new(0, 14, 1, -16)
    BG.BackgroundColor3 = P.Bg
    BG.BorderSizePixel = 0
    BG.Parent = Card
    corner(BG, 3)

    local Fill = Instance.new("Frame")
    Fill.Size = UDim2.new((Config[key] - minVal) / (maxVal - minVal), 0, 1, 0)
    Fill.BackgroundColor3 = P.Accent
    Fill.BorderSizePixel = 0
    Fill.Parent = BG
    corner(Fill, 3)

    local function updateFromX(x)
        local rel = math.clamp((x - BG.AbsolutePosition.X) / BG.AbsoluteSize.X, 0, 1)
        local val = minVal + (maxVal - minVal) * rel
        val = math.floor(val / step + 0.5) * step
        Config[key] = val
        VLabel.Text = tostring(val)
        Fill.Size = UDim2.new(rel, 0, 1, 0)
    end

    local hit = Instance.new("TextButton")
    hit.Size = UDim2.new(1, 0, 1, 0)
    hit.BackgroundTransparency = 1
    hit.Text = ""
    hit.Parent = BG

    track(hit.MouseButton1Down:Connect(function()
        ActiveSlider = updateFromX
        updateFromX(UserInputService:GetMouseLocation().X)
    end))
end

